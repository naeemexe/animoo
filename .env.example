# Copy to .env and fill in. .env is gitignored; never commit keys.

# Nemotron backend (server/llm.py): opencode | nvidia | openai
#   opencode: the local OpenCode CLI, free Nemotron, no key needed (the default)
#   nvidia:   build.nvidia.com (integrate.api.nvidia.com/v1) with NVIDIA_API_KEY
#   openai:   any OpenAI-compatible server: NEMOTRON_BASE_URL + NEMOTRON_API_KEY
LLM_BACKEND=opencode
# Leave empty for the backend's default (opencode: opencode/nemotron-3.5-lightning-free)
NEMOTRON_MODEL=
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
# OpenCode only: the CLI, and the scratch folder it runs in (default ~/.cache/animo-world/opencode)
OPENCODE_BIN=
OPENCODE_DIR=

# Hugging Face token (Kimodo needs Llama-3-8B-Instruct access)
HF_TOKEN=

# GPU servers, reached through the SSH tunnel (gpu/tunnel.sh)
MOTION_URL=http://localhost:8101
ASSET_URL=http://localhost:8102
