# Copy to .env and fill in. .env is gitignored; never commit keys.

# Nemotron routing (server/llm.py). LLM_BACKEND is where the fallback chain starts:
#   nvidia:   per-agent hosted model (build.nvidia.com, NVIDIA_API_KEY) -> self-hosted -> OpenCode -> mock
#   openai:   self-hosted OpenAI-compatible server (NEMOTRON_BASE_URL) -> OpenCode -> mock
#   opencode: the local OpenCode CLI's free Nemotron -> mock
#   off:      no LLM: every call uses the mock (tests the offline path)
LLM_BACKEND=nvidia
# Hosted model per agent (empty = the default shown)
LLM_MODEL_ORCHESTRATOR=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_MODEL_SELFCHECK=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_MODEL_WORLD=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODEL_MOTION=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODEL_DIRECTOR=nvidia/nemotron-3.5-lightning-30b-a3b
LLM_MODEL_CHAT=nvidia/nemotron-3.5-lightning-30b-a3b
# Reasoning per agent (1/0; default off: it makes a plan take 30-70 s instead of 3 s)
LLM_THINK_ORCHESTRATOR=
# Self-hosted tier: the Nano 9B on the GPU box (vLLM, tunnelled to :8104), always with /no_think
NEMOTRON_BASE_URL=http://localhost:8104/v1
NEMOTRON_MODEL=nemotron
NVIDIA_API_KEY=
NEMOTRON_API_KEY=
# OpenCode only: the CLI, and the scratch folder it runs in (default ~/.cache/animoo/opencode)
OPENCODE_BIN=
OPENCODE_DIR=

# Hugging Face token (Kimodo needs Llama-3-8B-Instruct access)
HF_TOKEN=

# GPU servers, reached through the SSH tunnel (gpu/tunnel.sh)
MOTION_URL=http://localhost:8101
ASSET_URL=http://localhost:8102
